<Project Sdk="Microsoft.NET.Sdk">
  <!-- Local build shim: builds SimpleSort (upstream sources + GraveAutoLootSort.cs)
       against a libs\ folder of game/BepInEx DLLs, like the OtArmorStand projects.
       Build: dotnet build local.build.csproj -c Release -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SimpleSort</AssemblyName>
    <RootNamespace>SimpleSort</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="obj/**;bin/**" />
    <Reference Include="..\libs\*.dll">
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
